# SPDX-License-Identifier: Apache-2.0
#
# Copy this file to .env, then configure the models and API keys available to your account:
#   cp .env.example .env
#
# See docs/SETUP.md for authentication and benchmark-specific requirements.
# Values already set in the shell take precedence over this file.

# Vertex AI project and region. The region defaults to global.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=

# Executor: OpenCode provider/model syntax. Judge: bare model ID.
HARNESS2_SOLVER_MODEL=
HARNESS2_JUDGE_MODEL=

# Optional; an empty improver setting uses the executor model.
HARNESS2_IMPROVER_MODEL=

# Optional output root; an empty value keeps the default runs/ location.
HARNESS2_RUNS_DIR=

# Google ADK LoopAgent (`loop_agent`) LLM API keys and runtime settings.
# Setting GOOGLE_API_KEY, GEMINI_API_KEY, or ADK_API_KEY automatically configures google-adk.
GOOGLE_API_KEY=
GEMINI_API_KEY=
ADK_API_KEY=
HARNESS2_ADK_MODEL=gemini-2.5-pro
ADK_MODEL=
HARNESS2_ADK_MAX_ITERATIONS=3
ADK_MAX_ITERATIONS=
HARNESS2_ADK_COMMAND_TIMEOUT=120
ADK_COMMAND_TIMEOUT=

# Optional additional provider API keys (OpenAI / Anthropic).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Optional Codex Responses API settings. harness2-bridge prints these values;
# see docs/SETUP.md#codex-executor for that workflow or another endpoint.
HARNESS2_CODEX_BASE_URL=
HARNESS2_CODEX_CONTAINER_URL=
HARNESS2_CODEX_API_KEY=
HARNESS2_CODEX_MODEL=

# Optional JobBench judge endpoint override and its access key.
HARNESS2_JUDGE_BASE_URL=
HARNESS2_JUDGE_API_KEY=
